# Copy to .env.local for development. Never commit real values.

# --- Database (server-side only, never exposed to the browser) -------------
# Your Neon connection string: Neon dashboard > your project > Connect > copy it.
# Then run:  npm run db:setup
DATABASE_URL=

# --- Backend ---------------------------------------------------------------
# /api uses this project's own server and your Neon database (the normal setup).
# Leave empty to run on the built-in in-browser store (nothing is saved).
NEXT_PUBLIC_API_URL=/api

# --- Site ------------------------------------------------------------------
# Public address of the storefront (used for the sitemap and share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Manager sign-in (server-side only) -------------------------------------
# Long random text that signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=
# Create staff logins with:  npm run manager:create

# --- Online payment: Paystack (optional) -------------------------------------
# Paystack dashboard > Settings > API Keys. Use the TEST secret key (sk_test_...) first.
# Then set the webhook URL there to:  https://YOUR-SITE/api/payments/webhook
# Leave empty and orders are saved with "pay on contact" as before.
PAYSTACK_SECRET_KEY=

# --- Order emails: Resend (optional) -----------------------------------------
# resend.com > API Keys. MAIL_FROM must be an address on a domain you verified there.
# ALERT_EMAIL is where new-order alerts go (defaults to the trade email in Store Settings).
RESEND_API_KEY=
MAIL_FROM=GBHPL <orders@yourdomain.com>
ALERT_EMAIL=
