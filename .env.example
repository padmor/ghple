# Copy to .env.local for development. Never commit real values.

# --- Database (server-side only, never exposed to the browser) -------------
# Your Neon connection string: Neon dashboard > your project > Connect > copy it.
# Then run:  npm run db:setup
DATABASE_URL=

# --- Backend ---------------------------------------------------------------
# /api uses this project's own server and your Neon database (the normal setup).
# Leave empty to run on the built-in in-browser store (nothing is saved).
NEXT_PUBLIC_API_URL=/api

# --- Site ------------------------------------------------------------------
# Public address of the storefront (used for the sitemap and share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Manager sign-in (server-side only) -------------------------------------
# Long random text that signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=
# Create staff logins with:  npm run manager:create
